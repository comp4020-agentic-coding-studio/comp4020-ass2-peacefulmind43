---
import Card from "astro-theme-university/components/Card.astro";
import CardGrid from "astro-theme-university/components/CardGrid.astro";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import heroImage from "../assets/images/hero-home.avif";
import { courseMeta } from "../course-config";
import { sessionLabels, siteConfig } from "../site-config";
---

<ContentLayout
  title={`${courseMeta.code}: ${courseMeta.title}`}
  description={courseMeta.description}
  heroImage={heroImage}
  heroImageAlt="A fanned hand of playing cards, reduced to flat gold and black shapes, framed by a spare branching decision tree above them, in a two-ink risograph print"
  {...siteConfig}
>
  <ul class="course-tags" aria-label="Course tags">
    {courseMeta.tags.map((tag) => <li>{tag}</li>)}
  </ul>

  <h2>What you will do</h2>
  <p>
    You will spend the semester turning specific pieces of poker folklore
    into either a theorem or a retraction. Each week takes one thing strong
    players say by instinct — that a hand is worth playing, that a fold was
    correct, that an opponent is bluffing — and asks what has to be true
    about probability, information and incentives for that instinct to
    survive contact with a computed number. You leave with worked
    derivations for the results that hold, and a named list of the ones
    that don't.
  </p>

  <h2>Who it is for</h2>
  <p>
    This assumes comfort with basic probability and the patience for
    combinatorics and algebra worked by hand; no poker experience and no
    programming are required. It suits someone more interested in why a
    play is correct than in whether it wins — if you are after strategy
    coaching, this course was never trying to be that.
  </p>

  <h2>Where to go next</h2>
  <CardGrid columns={2}>
    <Card title="Lectures" href="/lectures/">
      <p>
        The twelve weeks, in order, and what each one proves or retracts.
      </p>
    </Card>
    <Card title={sessionLabels.plural} href="/sessions/">
      <p>The weekly schedule and what happens in each teaching session.</p>
    </Card>
    <Card title="Assessment" href="/assessments/">
      <p>What is marked, what it is worth, and when it is due.</p>
    </Card>
    <Card title="People" href="/people/">
      <p>Who teaches the course and how to reach them.</p>
    </Card>
  </CardGrid>
</ContentLayout>

<style>
  .course-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block: 0 2rem;
    padding: 0;
    list-style: none;
  }

  .course-tags li {
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    color: var(--at-text-secondary);
    background: var(--at-bg-alt);
    font-size: 0.9rem;
  }
</style>
